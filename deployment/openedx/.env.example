# Публичные несекретные параметры Open edX ABC4RD.
# Пароли, токены и приватные ключи здесь хранить запрещено.

ABC4RD_LMS_HOST=learn.abc4rd.org
ABC4RD_CMS_HOST=studio.abc4rd.org
ABC4RD_PLATFORM_NAME=ABC4RD Academy
ABC4RD_CONTACT_EMAIL=academy@abc4rd.org
ABC4RD_DEFAULT_LANGUAGE=en
ABC4RD_ENABLE_HTTPS=true
ABC4RD_TUTOR_VERSION=21.0.8
ABC4RD_INSTALL_ROOT=/opt/abc4rd
