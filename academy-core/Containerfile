FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN useradd --system --uid 10001 --create-home abc4rd \
    && install -d -o abc4rd -g abc4rd /var/lib/abc4rd

WORKDIR /opt/abc4rd
COPY academy-core/ /opt/abc4rd/
RUN pip install --no-cache-dir .

USER abc4rd
VOLUME ["/var/lib/abc4rd"]
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)" || exit 1

CMD ["academy-core", "serve", "--db", "/var/lib/abc4rd/academy-core.db", "--host", "0.0.0.0", "--port", "8080"]
